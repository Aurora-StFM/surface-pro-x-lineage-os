# Surface Pro X LineageOS port: pinned versions.
# Values already set in the environment win over the defaults below.

# LineageOS branch the device tree targets, and the matching release code
# that breakfast/lunch use (vendor/lineage/vars/aosp_target_release).
: "${LINEAGE_BRANCH:=lineage-23.2}"
: "${LINEAGE_RELEASE:=bp4a}"

# The kernel comes from the Fedora port: same linux-surface commit, same
# patches, same base configs. Only the Android config fragment is added here.
# Bump FEDORA_KIT_COMMIT to follow kernel work done in the Fedora port.
: "${FEDORA_KIT_REPO:=https://github.com/Aurora-StFM/surface-pro-x-fedora.git}"
: "${FEDORA_KIT_COMMIT:=ac70073301da5016c13a58e41fb887a6ab423077}"

# Suffix of the kernel release string (uname -r).
: "${KERNEL_LOCALVERSION:=-spx-android}"

# Device tree blob GRUB loads for Android (same one Fedora uses).
SPX_DTB="qcom/sc8180x-surface-pro-x.dtb"

# Where build outputs go. prebuilt/ is read by BoardConfig.mk and device.mk.
: "${OUT_DIR:=$PWD/out}"
