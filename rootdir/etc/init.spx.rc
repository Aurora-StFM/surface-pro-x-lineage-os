# Surface Pro X init configuration.
# Imported automatically as /vendor/etc/init/hw/init.${ro.hardware}.rc

on early-init
    # minigbm (gralloc) would allocate GPU buffers in Qualcomm's compressed
    # UBWC layout, which the CPU cannot map. Rendering is done on the CPU
    # (SwiftShader) for now, so every buffer must be plain linear memory.
    # Inherited by all services started after this; the allocator service
    # below also sets it itself, since that is the one that decides.
    export MINIGBM_DEBUG nocompression

    # Modules nothing asks for by modalias (qrtr itself is built in).
    # The rest load from ueventd.
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules \
        qcom_pd_mapper

on fs
    mount_all /vendor/etc/fstab.spx --early

on late-fs
    mount_all /vendor/etc/fstab.spx --late

on post-fs-data
    mkdir /data/vendor/rmtfs 0770 root system
    mkdir /data/vendor/tmp 0771 root system
    mkdir /data/vendor/tmp/tqftpserv 0770 root system
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    # The modem DSP (which runs the Wi-Fi firmware) is started by rmtfs.
    exec_start vendor.spx-rmtfs-prepare
    start vendor.rmtfs
    start vendor.tqftpserv

on boot
    swapon_all /vendor/etc/fstab.spx
    # Let the bring-up log helper and others read the kernel log.
    write /proc/sys/kernel/dmesg_restrict 0

# Zero-filled modem file system images, like the Fedora port's rmtfs-prepare:
# the modem's real EFS partitions can't be reached from Linux yet.
service vendor.spx-rmtfs-prepare /vendor/bin/spx-rmtfs-prepare.sh
    class core
    user root
    group root system
    oneshot
    disabled

service vendor.rmtfs /vendor/bin/rmtfs -r -s -o /data/vendor/rmtfs
    class core
    user root
    group root system
    disabled

service vendor.tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group root system
    disabled

# minigbm's allocator service, redefined to set MINIGBM_DEBUG directly (see
# early-init). Same as the module's own .rc apart from the setenv line.
service vendor.graphics.allocator-4-0 /vendor/bin/hw/android.hardware.graphics.allocator@4.0-service.minigbm_msm
    override
    interface android.hardware.graphics.allocator@4.0::IAllocator default
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    setenv MINIGBM_DEBUG nocompression
    onrestart restart surfaceflinger
    task_profiles ServiceCapacityLow
